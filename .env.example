# Korum Lab — Environment Variables
# Copy to .env and fill in your keys.

# --- LLM (Required) ---
OPENAI_API_KEY=sk-...

# --- Neo4j Graph (Required for graph injection) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=korumlab

# --- KorumOS Bridge (Step 4 — push pre-tested queries to KorumOS Council) ---
KORUMOS_URL=https://korum-os.com
KORUMOS_API_KEY=          # Bearer token — set KORUM_API_KEY in KorumOS env to match

# --- ANCHOR Bridge ("Send to Anchor" — archive a decision into ANCHOR's memory) ---
# ANCHOR has no fixed local port committed in its repo (it's run via
# `uvicorn runtime:app --port $PORT`, deployed on Railway) — set this to
# wherever your anchor-runtime instance is actually reachable, local or cloud.
ANCHOR_URL=
ANCHOR_API_KEY=           # Bearer token — must match ANCHOR_API_KEY in anchor-runtime's env
